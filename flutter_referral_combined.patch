+      case 'expired':
+        return AppColors.danger;
+      case 'qualified':
+        return AppColors.info;
+      default:
+        return AppColors.warning;
+    }
+  }
+
+  String get _statusLabel {
+    switch (item.status) {
+      case 'rewarded':
+        return 'Rewarded';
+      case 'expired':
