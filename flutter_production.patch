+/// Shown while waiting for the customer to enter their M-PESA PIN after a
+/// SasaPay STK push. Polls the backend (which is updated once SasaPay's
+/// own callback lands) rather than SasaPay directly, since SasaPay has no
+/// synchronous "check now" endpoint suitable for a tight polling loop.
+class _SasapayWaitingDialog extends StatefulWidget {
+  final String message;
+  final SasapayService service;
+  final String orderId;
+
+  const _SasapayWaitingDialog({
+    required this.message,
+    required this.service,
+    required this.orderId,
+  });
+
+  @override
+  State<_SasapayWaitingDialog> createState() => _SasapayWaitingDialogState();
+}
+
+class _SasapayWaitingDialogState extends State<_SasapayWaitingDialog> {
+  static const int _timeoutSeconds = 120;
+  static const Duration _pollInterval = Duration(seconds: 3);
+
+  Timer? _pollTimer;
+  int _secondsElapsed = 0;
+  String? _error;
+
+  @override
+  void initState() {
+    super.initState();
+    _pollTimer = Timer.periodic(_pollInterval, (_) => _poll());
+  }
+
+  @override
+  void dispose() {
+    _pollTimer?.cancel();
+    super.dispose();
+  }
+
+  Future<void> _poll() async {
+    _secondsElapsed += _pollInterval.inSeconds;
+
+    if (_secondsElapsed >= _timeoutSeconds) {
+      _pollTimer?.cancel();
+      if (mounted) Navigator.pop(context, false);
+      return;
+    }
+
+    try {
+      final SasapayStatusResult status = await widget.service.checkStatus(widget.orderId);
+      if (status.isPaid) {
+        _pollTimer?.cancel();
+        if (mounted) Navigator.pop(context, true);
+      } else if (status.isFailed) {
+        _pollTimer?.cancel();
+        if (mounted) Navigator.pop(context, false);
+      }
+    } catch (e) {
+      // Transient network errors shouldn't abandon the wait — just keep
+      // polling until the timeout.
+      if (mounted) setState(() => _error = 'Having trouble checking status...');
+    }
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    return WillPopScope(
+      onWillPop: () async => false,
+      child: Dialog(
+        shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(16)),
+        child: Padding(
+          padding: const EdgeInsets.all(24),
+          child: Column(
+            mainAxisSize: MainAxisSize.min,
+            children: <Widget>[
+              const CircularProgressIndicator(color: Color(0xFF00A651)),
+              const SizedBox(height: 20),
+              const Text(
+                'Check your phone',
+                style: TextStyle(fontSize: 17, fontWeight: FontWeight.bold),
+              ),
+              const SizedBox(height: 8),
+              Text(
+                widget.message,
+                textAlign: TextAlign.center,
+                style: TextStyle(fontSize: 13, color: Colors.grey.shade600),
+              ),
+              if (_error != null) ...<Widget>[
+                const SizedBox(height: 8),
+                Text(_error!, style: TextStyle(fontSize: 11.5, color: Colors.orange.shade700)),
+              ],
+              const SizedBox(height: 20),
+              TextButton(
+                onPressed: () {
+                  _pollTimer?.cancel();
+                  Navigator.pop(context, false);
+                },
+                child: const Text('Cancel'),
+              ),
+            ],
+          ),
+        ),
+      ),
+    );
+  }
+}
