+  Future<void> _paySasapay() async {
+    setState(() => _isPaying = true);
+    String? orderId;
+    try {
+      orderId = await _createDraftOrder();
+
+      final SasapayInitiateResult initiated = await _sasapayService.initiatePayment(
+        orderId: orderId,
+        phoneNumber: _phoneCtrl.text.trim(),
+      );
+
+      if (!mounted) return;
+      setState(() => _isPaying = false);
+
+      final bool? paid = await showDialog<bool>(
+        context: context,
+        barrierDismissible: false,
+        builder: (_) => _SasapayWaitingDialog(
+          message: initiated.message,
+          service: _sasapayService,
+          orderId: orderId!,
+        ),
+      );
+
+      if (paid == true) {
+        if (!mounted) return;
+        _showSnack('Payment confirmed! 🎉', Colors.green.shade700);
+        Navigator.pushReplacementNamed(
+          context,
+          '/orderConfirmation',
+          arguments: widget.order.copyWith(id: orderId),
+        );
+      } else {
+        await _cancelDraft(orderId);
+        if (mounted) {
+          _showSnack(
+            paid == false ? 'Payment was not completed' : 'Payment cancelled',
+            Colors.orange.shade700,
+          );
+        }
+      }
+    } catch (e) {
+      if (orderId != null) await _cancelDraft(orderId);
+      if (mounted) _showSnack('Payment failed: $e', Colors.red.shade700);
+    } finally {
+      if (mounted) setState(() => _isPaying = false);
+    }
+  }
+
